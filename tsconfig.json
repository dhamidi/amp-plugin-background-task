{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": false,
		"exactOptionalPropertyTypes": true,
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["bun", "node"],
		"verbatimModuleSyntax": true
	},
	"include": ["scripts/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
